{
  "name": "@midnight-ntwrk/example-nft-contracts",
  "version": "0.2.0",
  "description": "NFT smart contract examples for the Midnight blockchain, including a standard public NFT and a privacy-preserving ZK NFT",
  "license": "Apache-2.0",
  "author": "Midnight Foundation",
  "repository": {
    "type": "git",
    "url": "https://github.com/midnightntwrk/example-nft-contracts.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "compact": "compact compile contracts/nft/src/nft.compact contracts/managed/nft && compact compile contracts/nft-zk/src/nft-zk.compact contracts/managed/nft-zk",
    "test": "vitest run",
    "test:compile": "yarn compact && vitest run",
    "lint": "eslint contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.1",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.19.0",
    "@midnight-ntwrk/ledger-v8": "^8.0.3",
    "@midnight-ntwrk/midnight-js-network-id": "^4.0.4",
    "@midnight-ntwrk/midnight-js-utils": "^4.0.4",
    "@midnight-ntwrk/wallet-sdk-address-format": "^3.0.0"
  },
  "packageManager": "yarn@1.22.22"
}
